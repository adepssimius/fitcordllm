# --- Anthropic ---------------------------------------------------------------
# Subscription auth — no API key needed. Generate once on a machine with a
# browser and paste the result here:
#
#   claude setup-token
#
# This draws on subscription rate limits, which are sized for interactive use.
CLAUDE_CODE_OAUTH_TOKEN=

# Alternative, for API billing. Resolution order is OAuth token, then API key.
# ANTHROPIC_API_KEY=

# Unset means the Claude Code default for the account.
# AGENT_MODEL=

# SDK turns one Discord message may spend.
AGENT_MAX_TURNS=80

# DEV ONLY. Forwards the full parent environment to the agent subprocess, for a
# locally brokered credential (e.g. running inside a Claude Code session).
# Never set this where the Discord or GitHub token is in the environment.
# AGENT_INHERIT_ENV=true

# --- Quota -------------------------------------------------------------------
# On subscription auth these are availability controls: exhausting the limit
# locks you out of Claude Code in your own editor.
AGENT_MAX_CONCURRENT_RUNS=2
AGENT_TURNS_PER_HOUR=300
QUOTA_WARN_UTILIZATION=0.8

# --- Storage -----------------------------------------------------------------
# Everything that must survive a restart lives under DATA_DIR: the database,
# one clone per thread, the cached Suunto CLI, and (via HOME) the SDK's session
# transcripts. HOME must also be on persistent storage or threads lose their
# memory on restart.
DATA_DIR=/data
# HOME=/data/home

# --- The repository ----------------------------------------------------------
# owner/name on GitHub. Each thread gets its own clone on its own branch.
GIT_REPO=
# Unset means the remote's default branch.
# GIT_BASE_BRANCH=
GIT_BRANCH_PREFIX=fitcord
# Fine-grained token with Contents read/write on GIT_REPO only. Held by the bot
# process; the agent never receives it.
GITHUB_TOKEN=
# Who the commits on the base branch are attributed to.
GIT_AUTHOR_NAME=fitcordllm
GIT_AUTHOR_EMAIL=fitcordllm@users.noreply.github.com
# Appended to the system prompt. Skipped when the repository has a CLAUDE.md.
REPO_INSTRUCTIONS_FILE=AGENTS.md
# An idle clone with nothing unshipped is removed after this many days.
WORKSPACE_IDLE_DAYS=14

# IANA zone for schedules and for the date the agent is told it is.
BOT_TIMEZONE=UTC

# --- Suunto ------------------------------------------------------------------
# Where the CLI comes from. Point SUUNTOOL_REPO at a fork that publishes
# release binaries to run a build with a feature upstream lacks.
SUUNTOOL_REPO=tajchert/suuntool
# A release tag, or `latest`. Pin it: `latest` can change under you on restart.
SUUNTOOL_VERSION=v0.10.0
# Skip the download and use this binary instead.
# SUUNTOOL_BIN=/usr/local/bin/suuntool
SUUNTOOL_MCP_ARGS=mcp --allow-write --allow-destructive
# From ~/.config/suuntool/session.json after `suuntool login`. The key is the
# secret; the rest are cosmetic, except EMAIL, which TOTP-signed writes use.
SUUNTOOL_SESSION_KEY=
SUUNTOOL_EMAIL=
SUUNTOOL_USERNAME=
SUUNTOOL_USER_KEY=
SUUNTOOL_COUNTRY=

# --- Liftosaur ---------------------------------------------------------------
LIFTOSAUR_API_KEY=

# --- Discord -----------------------------------------------------------------
# The Message Content privileged intent must be enabled in the developer portal,
# or every message inside a thread arrives with empty content.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Who may cause an agent turn. Startup REFUSES if both are empty: turns spend
# your personal Claude subscription, so an unset allowlist authorises nobody.
DISCORD_CHAT_USER_IDS=
DISCORD_CHAT_ROLE_IDS=

# Where an @mention opens a thread. Empty means any channel.
DISCORD_CHAT_CHANNEL_IDS=
# Where scheduled briefs are posted. Defaults to the first chat channel.
DISCORD_BRIEF_CHANNEL_ID=

# --- Polls -------------------------------------------------------------------
# How long a poll stays open if nobody answers. Discord's minimum is 1 hour.
POLL_DURATION_HOURS=24
# How long after the last tap before a vote is taken as final: short for a
# single choice, longer when several answers can be picked.
POLL_SETTLE_MS=4000
POLL_MULTI_SETTLE_MS=15000

# --- Schedules ---------------------------------------------------------------
# A brief more than this late (the bot was down) is skipped, not sent.
SCHEDULE_MAX_LATE_MS=10800000
# Refuse schedules that would fire more often than this.
SCHEDULE_MIN_INTERVAL_MIN=30

LOG_LEVEL=info
LOG_PRETTY=false
HTTP_PORT=8080
