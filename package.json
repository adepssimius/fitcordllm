{
  "name": "fitcordllm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "node --watch --enable-source-maps dist/main.js",
    "chat": "node --enable-source-maps dist/dev/chat.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "croner": "^9.1.0",
    "discord.js": "^14.16.3",
    "pino": "^9.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "pino-pretty": "^13.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
